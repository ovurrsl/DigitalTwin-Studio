# Supabase project "digitaltwin-studio" (client-safe values; set in Vercel for deployments).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# App data as dt_app (RLS-enforced), via the transaction pooler
DT_APP_DATABASE_URL=
# Better Auth (dt_auth via the transaction pooler; search_path is set on the role)
DT_AUTH_DATABASE_URL=
BETTER_AUTH_SECRET=
# Optional; defaults to the Vercel branch/production URL or http://localhost:3100
BETTER_AUTH_URL=
# Panel sign-in: TOTP enrolment is required unless set to "false"
DT_MFA_REQUIRED=
# One-time first-admin creation (POST /api/dt/bootstrap with x-dt-bootstrap-token)
DT_BOOTSTRAP_TOKEN=
DT_BOOTSTRAP_ADMIN_EMAIL=
# Mail (Resend). Without these, links are only logged / returned to admins.
RESEND_API_KEY=
DT_MAIL_FROM=
