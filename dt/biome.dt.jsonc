{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "quoteStyle": "single",
      "jsxQuoteStyle": "double"
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/node_modules", "!**/.next", "!studio/public", "!docs"]
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "overrides": [
    {
      // Ported verbatim from ovurrsl/panel so later panel changes diff cleanly.
      "includes": [
        "packages/panel/src/components/**",
        "packages/panel/src/lib/**",
        "packages/panel/src/panel.css"
      ],
      "linter": {
        "rules": {
          "suspicious": { "noDocumentCookie": "off" },
          "style": { "noNonNullAssertion": "off" },
          "complexity": { "noImportantStyles": "off" },
          "a11y": { "noSvgWithoutTitle": "off", "useAriaPropsSupportedByRole": "off" }
        }
      }
    }
  ]
}
