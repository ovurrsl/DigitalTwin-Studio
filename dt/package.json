{
  "name": "dt",
  "private": true,
  "workspaces": [
    "studio",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd studio && bun run dev",
    "build": "cd studio && bun run build",
    "check": "biome check --config-path=biome.dt.jsonc .",
    "check-types": "tsc -p tsconfig.packages.json",
    "protect": "bash scripts/protect.sh",
    "test": "cd packages/studio-ux && bun test",
    "test:db": "cd packages/db && bun test",
    "migrate": "cd packages/db && bun run migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.184.1",
    "next": "16.3.0",
    "react-grab": "0.1.50",
    "three": "0.186.0"
  },
  "patchedDependencies": {
    "iwer@2.3.0": "patches/iwer@2.3.0.patch",
    "three@0.186.0": "patches/three@0.186.0.patch"
  }
}
